<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/score_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/score_zero"
            android:textColor="@color/on_background"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pause_button"
            style="@style/Widget.TiltEscape.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/game_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/state_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay_scrim">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/tilt_instructions"
                android:textColor="@color/on_background"
                android:textSize="20sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/login_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <LinearLayout
                        android:id="@+id/login_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_neon_card"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Brand" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/login_title"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/login_subtitle"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary" />

                        <EditText
                            android:id="@+id/login_username"
                            style="@style/Widget.TiltEscape.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="@string/username_hint"
                            android:inputType="text"
                            android:maxLength="20"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/login_password"
                            style="@style/Widget.TiltEscape.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:hint="@string/password_hint"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/login_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Error"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/login_loading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:gravity="center"
                            android:text="@string/auth_loading"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/login_button"
                            style="@style/Widget.TiltEscape.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/login_action" />

                        <Button
                            android:id="@+id/show_register_button"
                            style="@style/Widget.TiltEscape.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/open_register" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/register_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <LinearLayout
                        android:id="@+id/register_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_neon_card"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Brand" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/register_title"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/register_subtitle"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary" />

                        <EditText
                            android:id="@+id/register_username"
                            style="@style/Widget.TiltEscape.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="@string/username_hint"
                            android:inputType="text"
                            android:maxLength="20"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/register_password"
                            style="@style/Widget.TiltEscape.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:hint="@string/password_hint"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/register_confirmation"
                            style="@style/Widget.TiltEscape.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:hint="@string/password_confirmation_hint"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/register_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Error"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/register_loading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:gravity="center"
                            android:text="@string/auth_loading"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/register_button"
                            style="@style/Widget.TiltEscape.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/register_action" />

                        <Button
                            android:id="@+id/register_back_button"
                            style="@style/Widget.TiltEscape.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/back_to_login" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/ready_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/screen_padding"
                android:background="@drawable/bg_neon_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_title"
                    android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                <TextView
                    android:id="@+id/current_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_menu_sensor_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/score_accent"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/tilt_instructions"
                    android:textColor="@color/on_background"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/start_button"
                    style="@style/Widget.TiltEscape.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/start_game" />

                <Button
                    android:id="@+id/how_to_play_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/how_to_play" />

                <Button
                    android:id="@+id/settings_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings" />

                <Button
                    android:id="@+id/achievements_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/achievements" />

                <Button
                    android:id="@+id/logout_button"
                    style="@style/Widget.TiltEscape.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/logout" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/how_to_play_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_app_gradient"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_neon_card"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/how_to_play_title"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/how_to_play_move"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:text="@string/how_to_play_score"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:text="@string/how_to_play_game_over"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Secondary" />

                        <Button
                            android:id="@+id/how_to_play_start_button"
                            style="@style/Widget.TiltEscape.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/how_to_play_start" />

                        <Button
                            android:id="@+id/how_to_play_back_button"
                            style="@style/Widget.TiltEscape.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/how_to_play_back" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/settings_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_app_gradient"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_neon_card"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_title"
                            android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/settings_sensitivity_title"
                            android:textColor="@color/on_background"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/sensitivity_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/sensitivity_low"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/sensitivity_low"
                                android:textColor="@color/on_background" />

                            <RadioButton
                                android:id="@+id/sensitivity_medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/sensitivity_medium"
                                android:textColor="@color/on_background" />

                            <RadioButton
                                android:id="@+id/sensitivity_high"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/sensitivity_high"
                                android:textColor="@color/on_background" />
                        </RadioGroup>

                        <Button
                            android:id="@+id/settings_back_button"
                            style="@style/Widget.TiltEscape.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/settings_back" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/pause_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/screen_padding"
                android:background="@drawable/bg_neon_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paused"
                    android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                <Button
                    android:id="@+id/resume_button"
                    style="@style/Widget.TiltEscape.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/resume" />

                <Button
                    android:id="@+id/restart_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/restart" />

                <Button
                    android:id="@+id/pause_main_menu_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/main_menu" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/game_over_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/screen_padding"
                android:background="@drawable/bg_neon_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_over"
                    android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                <TextView
                    android:id="@+id/final_score_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/score_zero"
                    android:textColor="@color/on_background"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/play_again_button"
                    style="@style/Widget.TiltEscape.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/play_again" />

                <Button
                    android:id="@+id/game_over_main_menu_button"
                    style="@style/Widget.TiltEscape.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/main_menu" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/achievements_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_app_gradient"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/achievements_title"
                        android:textAppearance="@style/TextAppearance.TiltEscape.Title" />

                    <TextView
                        android:id="@+id/achievements_high_score"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_neon_card"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/score_zero"
                        android:textColor="@color/accent"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/achievements_recent_title"
                        android:textAppearance="@style/TextAppearance.TiltEscape.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/achievements_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/achievements_loading"
                        android:textAppearance="@style/TextAppearance.TiltEscape.Body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/achievements_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/achievements_empty"
                        android:textAppearance="@style/TextAppearance.TiltEscape.Body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/achievements_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/achievements_error"
                        android:textAppearance="@style/TextAppearance.TiltEscape.Error"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/achievements_results_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/achievements_back_button"
                        style="@style/Widget.TiltEscape.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/achievements_back" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
